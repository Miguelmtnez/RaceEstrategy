# Copia este archivo a .env y rellena los valores de Strava.
PORT=3001
FRONTEND_URL=http://localhost:5173
# Opcional: para iniciar sesión desde el móvil en la misma Wi-Fi, añade la dirección http://IP_DEL_PC:5173
# FRONTEND_ALLOWED_ORIGINS=http://192.168.1.35:5173
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3001/api/strava/callback
# Genera una clave privada aleatoria: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Usar HTTPS con un dominio propio o proxy al desplegar en producción.
NODE_ENV=development

# Webhook: genera ambos con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STRAVA_WEBHOOK_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Opcional: identificador que entrega Strava al registrar el webhook
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
# Render con disco: DB_PATH=/var/data/app.sqlite
# En local, dejar DB_PATH sin configurar para usar backend/data/app.sqlite
